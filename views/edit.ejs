<%- include('partials/header') %>

<h2>Редагування адреси</h2>

<form action="/manage/edit/<%= subscriber.id %>" method="POST" class="mt-4">
    <div class="mb-3">
        <label class="form-label">Прізвище</label>
        <input type="text" name="last_name" class="form-control" value="<%= subscriber.last_name %>" required>
    </div>
    <div class="mb-3">
        <label class="form-label">Ім'я</label>
        <input type="text" name="first_name" class="form-control" value="<%= subscriber.first_name %>" required>
    </div>
    <div class="mb-3">
        <label class="form-label">По батькові</label>
        <input type="text" name="patronymic" class="form-control" value="<%= subscriber.patronymic %>" required>
    </div>
    <div class="mb-3">
        <label class="form-label">Email</label>
        <input type="email" name="email" class="form-control" value="<%= subscriber.email %>" required>
    </div>
    <button type="submit" class="btn btn-primary">Зберегти зміни</button>
    <a href="/manage" class="btn btn-secondary">Скасувати</a>
</form>

<%- include('partials/footer') %>